# Prisma SQLite database URL (local file path)
DATABASE_URL=file:./db/custom.db

# ----------------------------------------------------------------
# Supabase (backend sync for multiplayer rooms)
# ----------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
# - Project URL:  https://xxxxx.supabase.co
# - anon public:  eyJ... (long JWT string)
#
# Without these, the Room page runs in LOCAL mode (BroadcastChannel
# same-browser sync only). Add them to enable cross-device sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
